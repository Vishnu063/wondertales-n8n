    {
      "id": "3f438a06-133b-5c7b-b7ee-d3b640fa15e2",
      "name": "Prepare Versioned Character Library",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        0
      ],
      "parameters": {
        "jsCode": "const f=$input.first().json;\nconst characters=Array.from({length:10},(_,i)=>{\n const slot=String(i+1).padStart(2,'0'); const get=s=>String(f[`character_${slot}_${s}`] || '').trim();\n return {name:get('name'),facePrompt:get('face_prompt'),bodyPrompt:get('body_prompt'),referenceImage:get('reference_image'),continuityNotes:get('continuity_notes')};\n}).filter(c=>Object.values(c).some(Boolean));\nif(characters.length<2 || characters.some(c=>!c.name || !c.facePrompt || !c.bodyPrompt)) throw new Error('Fill at least two complete characters; leave unused slots fully blank.');\nreturn [{json:{version:String(f.libraryVersion || '').trim(),characters}}];"
      }
    },
