              "fieldType": "dropdown",
              "requiredField": true,
              "fieldOptions": {
                "values": [
                  {
                    "option": "9:16 vertical"
                  },
                  {
                    "option": "16:9 landscape"
                  }
                ]
              }
            },
            {
              "fieldLabel": "Target duration",
              "fieldType": "dropdown",
              "requiredField": true,
              "fieldOptions": {
                "values": [
                  {
                    "option": "30 seconds"
                  },
                  {
                    "option": "1 minute"
                  },
                  {
                    "option": "90 seconds"
                  },
                  {
                    "option": "2 minutes"
                  }
