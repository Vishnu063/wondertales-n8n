    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const form = $('Story Submission Form').first().json;\nconst registry = $('Character Registry (edit in n8n)').first().json;\nconst characterPool = Array.from({ length: 10 }, (_, index) => {\n  const slot = String(index + 1).padStart(2, '0');\n  const name = String(registry[`character_${slot}_name`] || '').trim();\n  const facePrompt = String(registry[`character_${slot}_face_prompt`] || '').trim();\n  const bodyPrompt = String(registry[`character_${slot}_body_prompt`] || '').trim();\n  const voice = String(registry[`character_${slot}_voice`] || '').trim();\n  return { name, facePrompt, bodyPrompt, voice };\n}).filter(character => character.name && character.facePrompt && character.bodyPrompt);\n\nif (characterPool.length < 2) {\n  throw new Error('Fill in at least two characters with a name, face description, and body/clothing description in the Character Registry node.');\n}\n\nconst language = String(form['Language'] || '').trim();\nconst formatChoice = String(form['Video format'] || '').trim();\nconst durationChoice = String(form['Target duration'] || '').trim();\nconst title = String(form['Story title'] || '').trim();\nconst story = String(form['Story / poem / rhyme'] || '').trim();\n\nif (!title || !story) throw new Error('Story title and story text are required.');\nif (!['English', 'Hindi'].includes(language)) throw new Error('Choose English or Hindi.');\nif (!['9:16 vertical', '16:9 landscape'].includes(formatChoice)) throw new Error('Choose a supported video format.');\n\nconst durationSeconds = {\n  '30 seconds': 30,\n  '1 minute': 60,\n  '90 seconds': 90,\n  '2 minutes': 120\n}[durationChoice];\nif (!durationSeconds) throw new Error('Choose a supported duration.');\n\nconst shuffled = [...characterPool];\nfor (let i = shuffled.length - 1; i > 0; i--) {\n  const j = Math.floor(Math.random() * (i + 1));\n  [shuffled[i], shuffled[j]] = [shuffled[j], shuffled[i]];\n}\nconst desiredCount = Math.random() < 0.5 ? 2 : 3;\nconst selectedCharacters = shuffled.slice(0, Math.min(desiredCount, shuffled.length));\nconst plannedSceneCount = Math.ceil(durationSeconds / 8);\n\nreturn {\n  json: {\n    requestId: String($execution.id),\n    title,\n    story,\n    language,\n    aspectRatio: formatChoice.startsWith('9:16') ? '9:16' : '16:9',\n    durationSeconds,\n    model: 'veo-lite',\n    plannedSceneCount,\n    selectedCharacters: selectedCharacters.map(character => ({ ...character, identity: 'entity' })),\n    uploadVisibility: 'private'\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
