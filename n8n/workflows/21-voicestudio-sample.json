{
  "name": "WonderTales — VoiceStudio Audio Sample (no Flow credits)",
  "nodes": [
    {
      "id": "0e922d4d-4c33-5411-bf41-e2d1f714822f",
      "name": "VoiceStudio Audio Sample Form",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "path": "wondertales-voice-sample",
        "formTitle": "Test narration without Flow credits",
        "formDescription": "Generates local speech and captions only. No Flow video or YouTube upload. First model loads/transcription can take several minutes. View or download the audio from n8n execution binary data.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Language",
              "fieldType": "dropdown",
              "requiredField": true,
              "fieldOptions": {
                "values": [
                  {
                    "option": "English"
                  },
                  {
                    "option": "Hindi"
                  }
                ]
              }
            },
            {
              "fieldLabel": "Voice alias (blank uses language default)",
              "fieldType": "text",
              "requiredField": false
            },
            {
              "fieldLabel": "Sample text (up to 300 characters)",
              "fieldType": "textarea",
              "requiredField": true
            },
            {
              "fieldLabel": "Sample ID (optional; reuse to resume saved speech)",
              "fieldType": "text",
              "requiredField": false
            }
          ]
        },
        "responseMode": "lastNode",
        "options": {}
      },
      "webhookId": "aa71773f-1410-5b52-a317-560347f59c20"
    },
    {
      "id": "c42d7b93-f8a8-56ad-a31a-74ea18d0594d",
      "name": "Prepare Audio Sample",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ],
      "parameters": {
        "jsCode": "const f=$input.first().json; return [{json:{language:f.Language,voiceAlias:String(f['Voice alias (blank uses language default)'] || '').trim(),text:String(f['Sample text (up to 300 characters)'] || '').trim(),sampleId:String(f['Sample ID (optional; reuse to resume saved speech)'] || '').trim()}}];"
      }
    },
    {
      "id": "5776084d-a9ee-578b-9112-a2798d56c02f",
      "name": "Generate Local Audio Sample",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        0
      ],
      "parameters": {
        "url": "http://127.0.0.1:8099/v1/voicestudio/sample",
        "method": "POST",
        "authentication": "genericCredentialType",
        "options": {
          "timeout": 1900000
        },
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ $json }}"
      },
      "retryOnFail": false
    },
    {
      "id": "962a32ae-698c-5c8b-9f5a-e1080fdfc91d",
      "name": "Download Sample Audio",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        0
      ],
      "parameters": {
        "url": "={{ 'http://127.0.0.1:8099' + $json.audioUrl }}",
        "method": "GET",
        "authentication": "genericCredentialType",
        "options": {
          "timeout": 120000,
          "response": {
            "response": {
              "responseFormat": "file",
              "outputPropertyName": "data"
            }
          }
        },
        "genericAuthType": "httpHeaderAuth"
      },
      "retryOnFail": false
    }
  ],
  "connections": {
    "VoiceStudio Audio Sample Form": {
      "main": [
        [
          {
            "node": "Prepare Audio Sample",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Prepare Audio Sample": {
      "main": [
        [
          {
            "node": "Generate Local Audio Sample",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Generate Local Audio Sample": {
      "main": [
        [
          {
            "node": "Download Sample Audio",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "tags": []
}
