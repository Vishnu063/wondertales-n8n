{
  "name": "WonderTales — Private Upload (one destination)",
  "nodes": [
    {
      "id": "5ec30481-41d6-522b-997d-555c5956aa51",
      "name": "Check Ready Jobs",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 1
            }
          ]
        }
      }
    },
    {
      "id": "bfbe71e6-b271-5ab4-aa6b-2b7508c01fbf",
      "name": "YouTube Destination (configure)",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        240,
        0
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "destination",
              "name": "destination",
              "value": "channel-main",
              "type": "string"
            },
            {
              "id": "expectedChannelId",
              "name": "expectedChannelId",
              "value": "",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      }
    },
    {
      "id": "ab3ada07-205c-51ec-b230-0d7676794f72",
      "name": "List Ready Jobs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        0
      ],
      "parameters": {
        "url": "http://127.0.0.1:8099/v1/jobs",
        "method": "GET",
        "authentication": "genericCredentialType",
        "options": {
          "timeout": 30000
        },
        "genericAuthType": "httpHeaderAuth"
      },
      "retryOnFail": false
    },
    {
      "id": "09c65670-4316-52e9-a754-f9ad750d8e74",
      "name": "Pick One Job for This Channel",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        0
      ],
      "parameters": {
        "jsCode": "const destination=$('YouTube Destination (configure)').first().json.destination; const j=$input.first().json.jobs.find(j=>j.state==='ready' && j.canClaimUpload===true && j.body.youtubeDestination===destination); return j ? [{json:j}] : [];"
      }
    },
    {
      "id": "f96cc53a-23dd-58e5-962d-a408a3363ad1",
      "name": "Verify Connected YouTube Account",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        960,
        0
      ],
      "parameters": {
        "url": "https://www.googleapis.com/youtube/v3/channels?part=id&mine=true",
        "method": "GET",
        "authentication": "predefinedCredentialType",
        "options": {
          "timeout": 30000
        },
        "nodeCredentialType": "youTubeOAuth2Api"
      },
      "retryOnFail": false
    },
    {
      "id": "390105e2-c647-5aff-b68b-0555ea0232b4",
      "name": "Guard Channel Identity",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        0
      ],
      "parameters": {
        "jsCode": "const c=$('YouTube Destination (configure)').first().json; if(!c.expectedChannelId || !$input.first().json.items?.some(x=>x.id===c.expectedChannelId)) throw new Error('Set the expected YouTube channel ID and connect the matching OAuth credential on BOTH Google nodes.'); return [{json:$('Pick One Job for This Channel').first().json}];"
      }
    },
    {
      "id": "11c33133-eb92-54b2-83b7-bb3276d999a6",
      "name": "Claim Upload",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1440,
        0
      ],
      "parameters": {
        "url": "={{ 'http://127.0.0.1:8099/v1/jobs/' + $json.id + '/claim-upload' }}",
        "method": "POST",
        "authentication": "genericCredentialType",
        "options": {
          "timeout": 30000
        },
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ {destination: $json.body.youtubeDestination} }}"
      },
      "retryOnFail": false
    },
    {
      "id": "14a822c7-3b2a-5a68-8333-2ef9804b1c10",
      "name": "Download Verified Video",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1680,
        0
      ],
      "parameters": {
        "url": "={{ 'http://127.0.0.1:8099/v1/jobs/' + $json.id + '/video' }}",
        "method": "GET",
        "authentication": "genericCredentialType",
        "options": {
          "timeout": 120000,
          "response": {
            "response": {
              "responseFormat": "file",
              "outputPropertyName": "data"
            }
          }
        },
        "genericAuthType": "httpHeaderAuth"
      },
      "retryOnFail": false
    },
    {
      "id": "0cd684fb-38f2-5807-b029-5867e514f239",
      "name": "Upload Private to YouTube",
      "type": "n8n-nodes-base.youTube",
      "typeVersion": 1,
      "position": [
        1920,
        0
      ],
      "parameters": {
        "resource": "video",
        "operation": "upload",
        "title": "={{ $('Claim Upload').first().json.body.title }}",
        "regionCode": "IN",
        "categoryId": "1",
        "binaryProperty": "data",
        "options": {
          "privacyStatus": "private",
          "selfDeclaredMadeForKids": true,
          "notifySubscribers": false,
          "defaultLanguage": "={{ $('Claim Upload').first().json.body.language === 'Hindi' ? 'hi' : 'en' }}",
          "description": "Children’s story created with AI-assisted animation. Uploaded privately for creator review."
        }
      },
      "retryOnFail": false
    },
    {
      "id": "45af7caa-1325-5a4f-bf24-b722f671d28e",
      "name": "Validate Upload Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2160,
        0
      ],
      "parameters": {
        "jsCode": "const id=$input.first().json.uploadId || $input.first().json.id; if(!/^[A-Za-z0-9_-]{11}$/.test(String(id||''))) throw new Error('Upload result is uncertain. Check YouTube and record its video ID in Job Recovery. Do not retry this upload.'); const j=$('Claim Upload').first().json; return [{json:{jobId:j.id,youtubeId:id,uploadClaim:j.uploadClaim}}];"
      }
    },
    {
      "id": "1cf558cb-8283-5847-a0e7-5edd105aa1cc",
      "name": "Record Private Upload",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2400,
        0
      ],
      "parameters": {
        "url": "={{ 'http://127.0.0.1:8099/v1/jobs/' + $json.jobId + '/complete-upload' }}",
        "method": "POST",
        "authentication": "genericCredentialType",
        "options": {
          "timeout": 30000
        },
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ {youtubeId:$json.youtubeId, uploadClaim:$json.uploadClaim} }}"
      },
      "retryOnFail": false
    }
  ],
  "connections": {
    "Check Ready Jobs": {
      "main": [
        [
          {
            "node": "YouTube Destination (configure)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "YouTube Destination (configure)": {
      "main": [
        [
          {
            "node": "List Ready Jobs",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "List Ready Jobs": {
      "main": [
        [
          {
            "node": "Pick One Job for This Channel",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Pick One Job for This Channel": {
      "main": [
        [
          {
            "node": "Verify Connected YouTube Account",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Verify Connected YouTube Account": {
      "main": [
        [
          {
            "node": "Guard Channel Identity",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Guard Channel Identity": {
      "main": [
        [
          {
            "node": "Claim Upload",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Claim Upload": {
      "main": [
        [
          {
            "node": "Download Verified Video",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Download Verified Video": {
      "main": [
        [
          {
            "node": "Upload Private to YouTube",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Upload Private to YouTube": {
      "main": [
        [
          {
            "node": "Validate Upload Result",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validate Upload Result": {
      "main": [
        [
          {
            "node": "Record Private Upload",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "tags": []
}
