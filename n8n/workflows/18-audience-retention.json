        "formDescription": "Use n8n execution results to see status and errors. All uploads remain Private.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Job ID (blank chooses an eligible public video)",
              "fieldType": "text",
              "requiredField": false
            }
          ]
        },
        "responseMode": "lastNode",
        "options": {}
      },
      "webhookId": "e81b0ce5-5ecc-5428-976d-bb75964a1705"
    },
    {
      "id": "0793bb7e-732a-5714-b18e-8bba96c7c53e",
      "name": "Retention Destination (configure)",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        240,
        0
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "destination",
              "name": "destination",
              "value": "channel-main",
              "type": "string"
            },
            {
              "id": "expectedChannelId",
              "name": "expectedChannelId",
              "value": "",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      }
    },
    {
      "id": "c1745a12-48c1-549c-b59e-d13162ab6aee",
      "name": "Read Current Growth Report",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        0
      ],
      "parameters": {
        "url": "http://127.0.0.1:8099/v1/growth/report",
        "method": "GET",
        "authentication": "genericCredentialType",
        "options": {
          "timeout": 30000
        },
        "genericAuthType": "httpHeaderAuth"
      },
      "retryOnFail": false
    },
    {
      "id": "4585e38c-0e70-57d8-9167-3d73b5f156e9",
      "name": "Choose One Video for Retention",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        0
      ],
      "parameters": {
        "jsCode": "const c=$('Retention Destination (configure)').first().json;\nif(!/^UC[A-Za-z0-9_-]{22}$/.test(c.expectedChannelId || '')) throw new Error('Set the expected channel ID and destination.');\nconst report=$input.first().json;\nconst requested=String(c['Job ID (blank chooses an eligible public video)'] || '').trim();\nif(requested && !/^[a-f0-9]{32}$/.test(requested)) throw new Error('Enter a valid Job ID.');\nif(requested) return [{json:{jobId:requested}}];\nconst options=(report.topVideosByWatchedMinutes || []).filter(v=>v.destination===c.destination);\nconst last=new Map((report.retention || []).map(r=>[r.jobId,r.snapshotAt || 0]));\noptions.sort((a,b)=>(last.get(a.jobId)||0)-(last.get(b.jobId)||0));\nreturn options.length ? [{json:{jobId:options[0].jobId}}] : [];"
      }
    },
    {
      "id": "48e61bed-e9f6-5a36-a1d5-7ed3531147d6",
      "name": "Read Managed Video Job",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        960,
        0
      ],
      "parameters": {
        "url": "={{ 'http://127.0.0.1:8099/v1/jobs/' + $json.jobId }}",
        "method": "GET",
        "authentication": "genericCredentialType",
        "options": {
          "timeout": 30000
        },
        "genericAuthType": "httpHeaderAuth"
      },
      "retryOnFail": false
    },
    {
      "id": "2555ae29-3a18-56cf-a7da-7e87444527de",
      "name": "Verify Retention Channel",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1200,
        0
      ],
      "parameters": {
        "url": "https://www.googleapis.com/youtube/v3/channels?part=id&mine=true",
        "method": "GET",
        "authentication": "predefinedCredentialType",
        "options": {
          "timeout": 30000
        },
        "nodeCredentialType": "youTubeOAuth2Api"
      },
      "retryOnFail": false
    },
    {
      "id": "94623f14-6a93-53ec-b239-3cfe8f9e852e",
      "name": "Guard Retention Ownership",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1440,
        0
      ],
      "parameters": {
        "jsCode": "const c=$('Retention Destination (configure)').first().json; const job=$('Read Managed Video Job').first().json;\nif(job.state!=='uploaded' || job.body.youtubeDestination!==c.destination || !/^[A-Za-z0-9_-]{11}$/.test(job.youtube_id || '')) throw new Error('Choose an uploaded managed video for this destination.');\nif(!($input.first().json.items || []).some(x=>x.id===c.expectedChannelId)) throw new Error('YouTube OAuth channel mismatch.');\nreturn [{json:{jobId:job.id,video:job.youtube_id,destination:c.destination,channelId:c.expectedChannelId}}];"
      }
    },
    {
      "id": "79e52e2b-4543-5438-8abc-a2c7d22d818c",
      "name": "Verify Video Is Public",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1680,
        0
      ],
      "parameters": {
        "url": "={{ 'https://www.googleapis.com/youtube/v3/videos?part=id,snippet,status&id=' + encodeURIComponent($json.video) }}",
        "method": "GET",
        "authentication": "predefinedCredentialType",
        "options": {
          "timeout": 30000
        },
        "nodeCredentialType": "youTubeOAuth2Api"
      },
      "retryOnFail": false
    },
    {
      "id": "f341b441-f692-54ff-ad70-a4e3b07753f8",
      "name": "Build Single Video Retention Query",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1920,
        0
      ],
      "parameters": {
        "jsCode": "const c=$('Guard Retention Ownership').first().json;\nconst v=($input.first().json.items || []).find(v=>v.id===c.video);\nif(!v || v.snippet?.channelId!==c.channelId || v.status?.privacyStatus!=='public') throw new Error('Retention review requires a verified public video on the selected channel.');\nconst end=new Date(); end.setUTCDate(end.getUTCDate()-2); const start=new Date(end); start.setUTCDate(start.getUTCDate()-27);\nconst startDate=start.toISOString().slice(0,10),endDate=end.toISOString().slice(0,10);\nconst q={ids:'channel=='+c.channelId,startDate,endDate,dimensions:'elapsedVideoTimeRatio',metrics:'audienceWatchRatio,relativeRetentionPerformance',filters:'video=='+c.video};\nconst url='https://youtubeanalytics.googleapis.com/v2/reports?'+Object.entries(q).map(([k,v])=>encodeURIComponent(k)+'='+encodeURIComponent(v)).join('&');\nreturn [{json:{...c,startDate,endDate,url}}];"
      }
    },
    {
      "id": "5c103506-ee19-5b99-983f-1d81cd2742cc",
      "name": "Read Retention (read-only OAuth)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2160,
        0
      ],
      "parameters": {
        "url": "={{ $json.url }}",
        "method": "GET",
        "authentication": "genericCredentialType",
        "options": {
          "timeout": 30000
        },
        "genericAuthType": "oAuth2Api"
      },
      "retryOnFail": false
    },
    {
      "id": "fa557199-bc7b-549f-ac9e-f187c6d39c6e",
      "name": "Normalize Retention Points",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2400,
        0
      ],
      "parameters": {
        "jsCode": "const c=$('Build Single Video Retention Query').first().json; const r=$input.first().json;\nconst names=(r.columnHeaders || []).map(h=>h.name); const required=['elapsedVideoTimeRatio','audienceWatchRatio','relativeRetentionPerformance'];\nif(r.error || required.some(k=>!names.includes(k))) throw new Error('Retention report failed or changed; previous data is preserved.');\nconst points=(r.rows || []).map(row=>Object.fromEntries(required.map(k=>[k,row[names.indexOf(k)]])));\nreturn [{json:{jobId:c.jobId,destination:c.destination,channelId:c.channelId,video:c.video,startDate:c.startDate,endDate:c.endDate,points}}];"
      }
    },
    {
      "id": "ac773f4d-69e8-5606-bd0d-fe6823c8f9e0",
      "name": "Save Private Retention Snapshot",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2640,
        0
      ],
      "parameters": {
        "url": "http://127.0.0.1:8099/v1/analytics/retention",
        "method": "POST",
        "authentication": "genericCredentialType",
        "options": {
          "timeout": 30000
        },
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ $json }}"
      },
      "retryOnFail": false
    },
    {
      "id": "66db4eee-2485-5293-be16-58cc8868a4fa",
      "name": "Show Updated Retention Review",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2880,
        0
      ],
      "parameters": {
        "url": "http://127.0.0.1:8099/v1/growth/report",
        "method": "GET",
        "authentication": "genericCredentialType",
        "options": {
          "timeout": 30000
        },
        "genericAuthType": "httpHeaderAuth"
      },
      "retryOnFail": false
    },
    {
      "id": "cf9d9791-91be-5a70-9a57-b529172a03ed",
      "name": "Show Selected Video Review",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3120,
        0
      ],
      "parameters": {
        "jsCode": "const id=$('Build Single Video Retention Query').first().json.jobId; return ($input.first().json.retention || []).filter(r=>r.jobId===id).map(r=>({json:r}));"
      }
    },
    {
      "id": "11221e8a-f413-5ea4-a1c6-a0f6e5580288",
      "name": "Weekly Retention Monday 9 30 AM",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        220
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "30 9 * * 1"
            }
          ]
        }
      }
    }
  ],
