{
  "name": "WonderTales — Thumbnail Preview",
  "nodes": [
    {
      "id": "dfe71ca7-b7af-59cd-9ffb-ac63fe520ac8",
      "name": "Thumbnail Preview Form",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "path": "wondertales-thumbnail",
        "formTitle": "Preview a video frame for its thumbnail",
        "formDescription": "Use n8n execution results to see status and errors. All uploads remain Private.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Job ID",
              "fieldType": "text",
              "requiredField": true
            },
            {
              "fieldLabel": "Frame",
              "fieldType": "dropdown",
              "requiredField": true,
              "fieldOptions": {
                "values": [
                  {
                    "option": "1"
                  },
                  {
                    "option": "2"
                  },
                  {
                    "option": "3"
                  }
                ]
              }
            }
          ]
        },
        "responseMode": "lastNode",
        "options": {}
      },
      "webhookId": "bdb02cec-1921-5783-ba49-831cc47ecf28"
    },
    {
      "id": "3a138316-526d-5f8e-8db4-90515c4679cc",
      "name": "Choose Saved Thumbnail",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ],
      "parameters": {
        "jsCode": "const f=$input.first().json; const id=String(f['Job ID']||'').trim(); if(!/^[a-f0-9]{32}$/.test(id) || !['1','2','3'].includes(f.Frame)) throw new Error('Enter a valid Job ID and choose a frame.'); return [{json:{id,frame:f.Frame}}];"
      }
    },
    {
      "id": "43f7558c-a6a5-5a38-b690-ab519025ce0d",
      "name": "Download Thumbnail Candidate",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        0
      ],
      "parameters": {
        "url": "={{ 'http://127.0.0.1:8099/v1/jobs/' + $json.id + '/thumbnail-' + $json.frame }}",
        "method": "GET",
        "authentication": "genericCredentialType",
        "options": {
          "timeout": 120000,
          "response": {
            "response": {
              "responseFormat": "file",
              "outputPropertyName": "data"
            }
          }
        },
        "genericAuthType": "httpHeaderAuth"
      },
      "retryOnFail": false
    }
  ],
  "connections": {
    "Thumbnail Preview Form": {
      "main": [
        [
          {
            "node": "Choose Saved Thumbnail",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Choose Saved Thumbnail": {
      "main": [
        [
          {
            "node": "Download Thumbnail Candidate",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "tags": []
}
