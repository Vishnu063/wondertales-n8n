{
  "name": "03-queue-monitor",
  "active": false,
  "nodes": [
    {
      "id": "schedule",
      "name": "Every hour",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 1
            }
          ]
        }
      }
    },
    {
      "id": "tick",
      "name": "Check approved queue",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        280,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:8099/api/tick",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 240000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={}"
      }
    },
    {
      "id": "jobs",
      "name": "Progress report",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        560,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "http://127.0.0.1:8099/api/jobs",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 240000
        }
      }
    }
  ],
  "connections": {
    "Every hour": {
      "main": [
        [
          {
            "node": "Check approved queue",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check approved queue": {
      "main": [
        [
          {
            "node": "Progress report",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "Asia/Kolkata"
  }
}
