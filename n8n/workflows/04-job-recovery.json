      ],
      "parameters": {
        "path": "wondertales-manage",
        "formTitle": "Recover or resume WonderTales jobs",
        "formDescription": "Use n8n execution results to see status and errors. All uploads remain Private.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Job ID",
              "fieldType": "text",
              "requiredField": true
            },
            {
              "fieldLabel": "Action",
              "fieldType": "dropdown",
              "requiredField": true,
              "fieldOptions": {
                "values": [
                  {
                    "option": "Resume safe steps"
                  },
                  {
                    "option": "Recover an existing scene clip"
                  },
                  {
                    "option": "Record an existing YouTube video ID"
                  },
                  {
                    "option": "Rebuild narration and captions"
                  },
                  {
                    "option": "Confirm a scene was never submitted"
                  },
                  {
                    "option": "Archive this job"
                  }
                ]
              }
            },
            {
              "fieldLabel": "Scene index (starts at 0)",
              "fieldType": "text",
              "requiredField": false
            },
            {
              "fieldLabel": "Type NOT_SUBMITTED only after checking Flow",
              "fieldType": "text",
              "requiredField": false
            },
            {
              "fieldLabel": "Recovered clip path (inside imports folder)",
              "fieldType": "text",
              "requiredField": false
            },
            {
              "fieldLabel": "YouTube video ID",
              "fieldType": "text",
              "requiredField": false
            }
          ]
        },
        "responseMode": "lastNode",
        "options": {}
      },
      "webhookId": "e909c5ab-e79a-5d55-9f81-710adf8df8a6"
    },
    {
      "id": "db4db8b6-1af8-5672-800e-adc838041c18",
      "name": "Prepare Recovery Action",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ],
      "parameters": {
        "jsCode": "const f=$input.first().json; const id=String(f['Job ID']||'').trim();\nif (!/^[a-f0-9]{32}$/.test(id)) throw new Error('Copy a valid Job ID from Job Status.');\nconst action={'Resume safe steps':'resume','Recover an existing scene clip':'recover','Record an existing YouTube video ID':'reconcile-upload','Rebuild narration and captions':'reset-narration','Confirm a scene was never submitted':'confirm-unsubmitted','Archive this job':'archive'}[f.Action];\nif(!action) throw new Error('Choose an action.');\nreturn [{json:{id,action,body:{confirmation:String(f['Type NOT_SUBMITTED only after checking Flow']||'').trim(),sceneIndex:Number(f['Scene index (starts at 0)']),filePath:String(f['Recovered clip path (inside imports folder)']||''),youtubeId:String(f['YouTube video ID']||'').trim()}}}];"
      }
    },
    {
      "id": "2b2d6cf2-64df-5ff5-8ef9-f794e7766a53",
      "name": "Apply Recovery Action",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        0
      ],
      "parameters": {
        "url": "={{ 'http://127.0.0.1:8099/v1/jobs/' + $json.id + '/' + $json.action }}",
        "method": "POST",
        "authentication": "genericCredentialType",
        "options": {
          "timeout": 30000
        },
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ $json.body }}"
      },
      "retryOnFail": false
    }
  ],
  "connections": {
